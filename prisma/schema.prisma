generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Usuários
model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  login      String    @unique
  password   String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  lastAccess DateTime? @map("last_access")
  active     Boolean   @default(true)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("users")
}

// Tipo do cliente
enum ClientType {
  PF
  PJ
}

// Clientes
model Client {
  id                String     @id @default(uuid())
  name              String
  fantasyName       String?    @map("fantasy_name")
  type              ClientType
  cpfCnpj           String     @unique @map("cpf_cnpj")
  stateRegistration String?    @map("state_registration")
  observation       String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime?  @updatedAt @map("updated_at")
  provider          Boolean    @default(false)
  active            Boolean    @default(true)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  emails             Email[]
  phones             Phone[]
  accountReceivables Account_receivable[]
  addresses          Address[]

  @@map("clients")
}

// E-mails
model Email {
  id       String  @id @default(uuid())
  address  String  @unique
  verified Boolean @default(false)

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  active    Boolean  @default(true)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("emails")
}

// Telefones
model Phone {
  id     String @id @default(uuid())
  number String

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  active    Boolean  @default(true)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("phones")
}

// Tipo da despesa
enum ExpenseType {
  Credito
  Debito
}

// Despesas
model Expense {
  id          String      @id @default(uuid())
  description String
  type        ExpenseType
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime?   @updatedAt @map("updated_at")
  active      Boolean     @default(true)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountPayables    Account_payable[]
  accountReceivables Account_receivable[]

  @@map("expense_categories")
}

// Status do pagamento
enum PaymentStatus {
  Pendente
  Pago
  Cancelado
}

// Contas a pagar
model Account_payable {
  id             String        @id @default(uuid())
  paymentDate    DateTime      @map("payment_date")
  status         PaymentStatus
  issueDate      DateTime      @map("issue_date")
  dueDate        DateTime      @map("due_date")
  invoiceAmount  Int           @map("invoice_amount")
  invoiceNumber  String        @map("invoice_number")
  penaltyAmount  Int?          @map("penalty_amount")
  interestAmount Int?          @map("interest_amount")
  observation    String?
  purchaseCode   String?       @map("purchase_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @updatedAt @map("updated_at")
  active         Boolean       @default(true)

  expenseId String  @map("expense_id")
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  paymentMethodId String         @map("payment_method_id")
  paymentMethod   Payment_method @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("account_payables")
}

// Contas a receber
model Account_receivable {
  id             String        @id @default(uuid())
  paymentDate    DateTime      @map("payment_date")
  status         PaymentStatus
  issueDate      DateTime      @map("issue_date")
  dueDate        DateTime      @map("due_date")
  invoiceAmount  Int           @map("invoice_amount")
  invoiceNumber  String        @map("invoice_number")
  penaltyAmount  Int?          @map("penalty_amount")
  interestAmount Int?          @map("interest_amount")
  description    String?
  observation    String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @updatedAt @map("updated_at")
  active         Boolean       @default(true)

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  expenseId String  @map("expense_id")
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  paymentMethodId String         @map("payment_method_id")
  paymentMethod   Payment_method @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("account_receivables")
}

// Tipos de pagamento
model Payment_type {
  id          String    @id @default(uuid())
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  active      Boolean   @default(true)

  paymentMethods Payment_method[]

  @@map("payment_types")
}

// Formas de pagamento
model Payment_method {
  id          String    @id @default(uuid())
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  active      Boolean   @default(true)

  paymentTypeId String       @map("payment_type_id")
  paymentType   Payment_type @relation(fields: [paymentTypeId], references: [id], onDelete: Cascade)

  accountReceivables Account_receivable[]
  accountPayables    Account_payable[]
  cashierMovements   Cashier_movement[]

  @@map("payment_methods")
}

// Caixa
model Cashier {
  id            String    @id @default(uuid())
  openingValue  Int       @map("opening_value")
  closingValue  Int?      @map("closing_value")
  cashierNumber Int       @map("cashier_number")
  openingDate   DateTime  @default(now()) @map("opening_date")
  closingDate   DateTime? @map("closing_date")
  active        Boolean   @default(true)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cashierMovements Cashier_movement[]

  @@map("cashiers")
}

// Movimentações do caixa
model Cashier_movement {
  id            String   @id @default(uuid())
  movementValue Int      @map("movement_value")
  movementDate  DateTime @default(now()) @map("movement_date")
  observation   String?

  cashierId String  @map("cashier_id")
  cashier   Cashier @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  paymentMethodId String         @map("payment_method_id")
  paymentMethod   Payment_method @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("cashier_movements")
}

// Endereços
model Address {
  id           String    @id @default(uuid())
  cep          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  uf           String
  ibgeCode     String    @map("ibge_code")
  latitude     Decimal?
  longitude    Decimal?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  isMain       Boolean   @default(false) @map("is_main")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  companyId String   @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// Empresa
model Company {
  id                String     @id @default(uuid())
  name              String
  fantasyName       String?    @map("fantasy_name")
  type              ClientType
  cpfCnpj           String     @unique @map("cpf_cnpj")
  stateRegistration String?    @map("state_registration")
  observation       String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime?  @updatedAt @map("updated_at")
  provider          Boolean    @default(false)
  active            Boolean    @default(true)

  users              User[]
  emails             Email[]
  phones             Phone[]
  addresses          Address[]
  clients            Client[]
  expenses           Expense[]
  accountPayables    Account_payable[]
  accountReceivables Account_receivable[]
  cashiers           Cashier[]
  cashierMovements   Cashier_movement[]

  @@map("companies")
}
