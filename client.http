@baseUrl = http://192.168.1.2:3333

@authToken = {{Autenticar_Usuário.response.body.access_token}}

# @name Criar_novo_usuário
POST {{baseUrl}}/accounts
Content-type: application/json

{
  "name": "John Doe",
  "email": "john.doe1@example.com",
  "login": "johndoe1",
  "password": "123456"
} 

###
# @name Atualizar_usuário
PUT {{baseUrl}}/accounts/b0809cf3-9160-4719-b0ce-c21db9536eba
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "John Doe Updated"
}

###
# @name Listar_Usuários
Get {{baseUrl}}/accounts
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
# @name Listar_Contas
Get {{baseUrl}}/accounts/b0809cf3-9160-4719-b0ce-c21db9536eba
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
# @name Autenticar_Usuário
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "login": "murilo2",
  "password": "123456"
}

###
# @name Create_question 
Post {{baseUrl}}/questions
Content-Type: application/json
Authorization: Bearer {{authToken}}
