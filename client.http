@baseUrl = http://localhost:3333

@authToken = {{authenticate_user.response.body.access_token}}

#Criar novo usuário
# @name Create_user
POST {{baseUrl}}/accounts
Content-type: application/json

{
  "name": "Lara Gratão",
  "email": "laragratao@gmail.com",
  "login": "lara",
  "password": "123456",
  "companyId": "6f2dc694-3091-4cda-8f85-cabc78b95dff"
} 

###
#Atualizar usuário
# @name Update_user
PUT {{baseUrl}}/accounts/b0809cf3-9160-4719-b0ce-c21db9536eba
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "John Doe Updated"
}

###
#Listar todos os usuários
# @name Listar_Usuários
Get {{baseUrl}}/accounts 
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
#Mostrar um usuário específico
# @name Show_account
Get {{baseUrl}}/accounts/cb895e2f-ce32-46cc-ba88-bb55dd7aac91
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
#Autenticar usuário
# @name authenticate_user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "murilo",
  "password": "123456"
}

###
#Criar nova empresa
# @name create_company
POST {{baseUrl}}/companies
Content-Type: application/json

{
  "name": "Vida e Movimento",
  "cpfCnpj": "41003782892",
  "type": "PF"
}

###
#Criar novo cliente
# @name create_client
POST {{baseUrl}}/clients
Content-Type: application/json

{
  "name": "Murilo Henrique",
  "type": "PF",
  "cpfCnpj": "42174674866",
  "companyId": "6f2dc694-3091-4cda-8f85-cabc78b95dff",
  "email": "murilo.lemes@gmail.com"
}

###
#Listar todos os clientes
# @name list_clients
GET {{baseUrl}}/clients/ee70ff1f-6fb1-4275-a5dd-6f8c79333687
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
#Listar todos os clientes
# @name list_clients
GET {{baseUrl}}/clients/6f2dc694-3091-4cda-8f85-cabc78b95dff
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
#Listar todos os clientes
# @name auth_me
GET {{baseUrl}}/auth/me
Content-Type: application/json
Authorization: Bearer {{authToken}}