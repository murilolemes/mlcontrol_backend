@baseUrl = http://192.168.1.2:3333

@authToken = {{authenticate_user.response.body.access_token}}

#Criar novo usuário
# @name Create_user
POST {{baseUrl}}/accounts
Content-type: application/json

{
  "name": "John Doe",
  "email": "john.doe1@example.com",
  "login": "johndoe1",
  "password": "123456"
} 

###
#Atualizar usuário
# @name Update_user
PUT {{baseUrl}}/accounts/b0809cf3-9160-4719-b0ce-c21db9536eba
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "John Doe Updated"
}

###
#Listar todos os usuários
# @name Listar_Usuários
Get {{baseUrl}}/accounts
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
#Mostrar um usuário específico
# @name Show_account
Get {{baseUrl}}/accounts/b0809cf3-9160-4719-b0ce-c21db9536eba
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
#Autenticar usuário
# @name authenticate_user
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "login": "murilo2",
  "password": "123456"
}

###
# @name Create_question 
Post {{baseUrl}}/questions
Content-Type: application/json
Authorization: Bearer {{authToken}}
